APP_NAME=Jarvis Brain
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000






SECURITY_RATE_LIMIT_WINDOW_SECONDS=60
SECURITY_RATE_LIMIT_MAX_REQUESTS=240
HASHICORP_VAULT_ADDR=
CLOUD_SECRET_MANAGER_ENDPOINT=
BACKUP_DIR=/var/www/jarvis/data/backups

LOG_FILE_PATH=/var/www/jarvis/data/logs/jarvis.jsonl
GIT_REPO=https://github.com/Janon-Emersion-T/myjarv.git


DATABASE_BACKEND=sqlite
DATABASE_PATH=/var/www/jarvis/data/jarvis.sqlite3
POSTGRES_DSN=

SECURITY_SECRET_KEY=replace-with-long-random-secret
SECURITY_BOOTSTRAP_ADMIN=janon
SECURITY_BOOTSTRAP_PASSWORD=replace-with-strong-password
SECURITY_REQUIRE_AUTH=false
PRODUCTION_LOCK_MODE=false
LOCAL_AUTH_TOKEN=jarvis-local-dev-token