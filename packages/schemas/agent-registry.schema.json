{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lkprofessionals.local/schemas/agent-registry.schema.json",
  "title": "Jarvis Agent Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agents"
  ],
  "properties": {
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "role",
          "department",
          "model_role",
          "prompt_file",
          "profile_path",
          "description",
          "responsibility",
          "priority",
          "risk_level",
          "approval_level",
          "tools",
          "authority_scope"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "department": {
            "type": "string",
            "minLength": 1
          },
          "model_role": {
            "type": "string",
            "enum": [
              "orchestrator",
              "coder",
              "fast",
              "research",
              "customer_support"
            ]
          },
          "prompt_file": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+\\.md$"
          },
          "profile_path": {
            "type": "string",
            "pattern": "^packages/agents/prompts/[A-Za-z0-9_.-]+\\.md$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "responsibility": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "risk_level": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "approval_level": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "tools": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "authority_scope": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
