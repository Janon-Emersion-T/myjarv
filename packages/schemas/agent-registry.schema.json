{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lkprofessionals.local/schemas/agent-registry.schema.json",
  "title": "Jarvis Agent Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "generated_on",
    "source_company_structure",
    "departments",
    "agents"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "generated_on": {
      "type": "string",
      "minLength": 1
    },
    "source_company_structure": {
      "type": "string",
      "minLength": 1
    },
    "departments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "display_name",
          "owner",
          "backup_owner",
          "executive_sponsor",
          "teams",
          "agent_count",
          "agents"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "backup_owner": {
            "type": "string",
            "minLength": 1
          },
          "executive_sponsor": {
            "type": "string",
            "minLength": 1
          },
          "teams": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "agent_count": {
            "type": "integer",
            "minimum": 1
          },
          "agents": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "slug",
          "display_name",
          "role",
          "position",
          "department",
          "company_department",
          "team",
          "team_display_name",
          "model_role",
          "prompt_file",
          "profile_path",
          "description",
          "responsibility",
          "priority",
          "seniority",
          "risk_level",
          "approval_level",
          "tools",
          "knowledge_domains",
          "memory_permissions",
          "execution_permissions",
          "authority_scope",
          "fallback_agent",
          "collaboration_partners",
          "status",
          "version",
          "last_updated"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "slug": {
            "type": "string",
            "minLength": 1
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": "string",
            "minLength": 1
          },
          "department": {
            "type": "string",
            "minLength": 1
          },
          "company_department": {
            "type": "string",
            "minLength": 1
          },
          "team": {
            "type": "string",
            "minLength": 1
          },
          "team_display_name": {
            "type": "string",
            "minLength": 1
          },
          "model_role": {
            "type": "string",
            "enum": [
              "orchestrator",
              "coder",
              "fast",
              "research",
              "customer_support"
            ]
          },
          "prompt_file": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+\\.md$"
          },
          "profile_path": {
            "type": "string",
            "pattern": "^packages/agents/prompts/[A-Za-z0-9_.-]+\\.md$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "responsibility": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "seniority": {
            "type": "string",
            "minLength": 1
          },
          "risk_level": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "approval_level": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "tools": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "knowledge_domains": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "memory_permissions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "execution_permissions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "authority_scope": {
            "type": "string",
            "minLength": 1
          },
          "fallback_agent": {
            "type": "string",
            "minLength": 1
          },
          "collaboration_partners": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive",
              "deprecated",
              "experimental"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "last_updated": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
