{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lkprofessionals.local/schemas/agent-profile.schema.json",
  "title": "Jarvis Agent Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "position",
    "department",
    "reports_to",
    "collaborates_with",
    "mission",
    "responsibilities",
    "skills",
    "tools",
    "knowledge_sources",
    "memory_access",
    "tool_access_level",
    "inputs",
    "input_validation_rules",
    "outputs",
    "output_quality_checklist",
    "review_checklist",
    "decision_authority",
    "approval_level",
    "risk_level",
    "escalation_rules",
    "escalation_message_template",
    "failure_response",
    "forbidden_actions",
    "common_mistakes_to_avoid",
    "performance_metrics",
    "example_tasks",
    "example_good_output",
    "example_bad_output",
    "version",
    "last_updated"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "position": {
      "type": "string",
      "minLength": 1
    },
    "department": {
      "type": "string",
      "minLength": 1
    },
    "reports_to": {
      "type": "string",
      "minLength": 1
    },
    "collaborates_with": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mission": {
      "type": "string",
      "minLength": 1
    },
    "responsibilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "knowledge_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "memory_access": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tool_access_level": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "input_validation_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "output_quality_checklist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review_checklist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decision_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "approval_level_ceiling"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "approval_level_ceiling": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "approval_level": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "escalation_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "escalation_message_template": {
      "type": "string",
      "minLength": 1
    },
    "failure_response": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "common_mistakes_to_avoid": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "performance_metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "example_tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "example_good_output": {
      "type": "string",
      "minLength": 1
    },
    "example_bad_output": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "last_updated": {
      "type": "string",
      "minLength": 1
    }
  }
}
